# Apache (GoDaddy cPanel) — the same job vercel.json does on Vercel.
#
# The site is one page that paints its own routes, so /about and /contact are
# not files on disk. Without this, Apache 404s on a refresh or a shared link.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── HTTPS ────────────────────────────────────────────────────────────────
  # ONLY after the SSL certificate is installed and https:// loads the site.
  # Enable it before that and every visitor hits a redirect loop into a page
  # the browser refuses to show. Delete the two # below to turn it on.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # A real file is served as-is: assets, images, robots.txt. So is a folder
  # that has its own index, which means /admin.
  #
  # A folder WITHOUT an index must not be served, or it shadows the page route
  # of the same name: /about is a page, and about/ is also where the founder
  # portrait lives. Matching -d there sent /about to Apache, which redirected
  # to /about/ and then refused to list it — a 403 on a real page.
  # ...and Apache must stop redirecting a folder to its trailing-slash form
  # before the rules below get a say, or /about is a 301 to /about/ again.
  # /admin keeps its slash explicitly, because the CMS there loads its own
  # files by relative path.
  DirectorySlash Off
  RewriteRule ^admin$ /admin/ [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]
  # Everything else is the app.
  RewriteRule . /index.html [L]
</IfModule>

# Hashed asset filenames change on every build, so they can be cached hard;
# index.html never can, or a visitor keeps the old app after a deploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
